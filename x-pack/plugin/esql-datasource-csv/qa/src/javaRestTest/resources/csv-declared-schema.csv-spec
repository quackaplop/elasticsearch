// CSV-only spec: a dataset that DECLARES its schema instead of letting inference derive it.
//
// A declared schema rides the `dataset:` directive under the reserved `mappings` key, which
// DatasetRegistry lifts out of the WITH JSON and sends as the PUT body's top-level `mappings` field --
// settings validation rejects unknown setting names, so a declaration cannot ride inside `settings`.
// The directive's other keys stay settings, so a case can cross a declaration with any format option.
//
// Do NOT add `required_capability: dataset_declared_schema`: that capability is advertised on
// PUT /_query/dataset/{name}, not on POST /_query, and a csv-spec's required_capability lines are
// resolved against the query endpoint only -- the line would skip every case here forever. The harness
// guards the PUT-side capability itself in AbstractExternalSourceSpecTestCase.
//
// employees_no_mv.csv has a TYPED, column-aligned header
// ("birth_date:date     ,emp_no:integer,first_name:keyword,...", 23 columns, 100 rows, emp_no 10001..10100).
// A declared `path` binds against the NAME HALF of that typed header ("emp_no:integer" -> "emp_no"), the
// same derivation inference uses, so declared and inferred reads name the same physical column.
// Dataset names encode their options: the same name always carries the same declaration.

// THE BASELINE: a declaration that says exactly what inference would have said. Declaring the truth must
// change nothing -- same column names, same types, same values as the inferred read. The expected table below
// is copied verbatim from csv-basic.csv-spec's readAllEmployeesScalar, which reads this same fixture with NO
// declaration, so any divergence between the two is a defect in the declared path rather than a test
// disagreement. Every other case in this file deliberately diverges from inference (renames, retypes, subsets);
// this one pins that the declared machinery is a no-op when it has nothing to change, which is the strict/
// dynamic orthogonality invariant at full strength (esql-planning#1307).
//
// Types are the INFERRED ones, i.e. post-widening: the fixture's typed header annotates emp_no:integer,
// height:double and so on, and those are what a declaration has to restate to be a no-op.
strictDeclaredSchemaMatchingInferenceChangesNothing
required_capability: dataset_in_from_command
dataset: employees_declared_noop: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"emp_no": {"type": "integer"}, "first_name": {"type": "keyword"}, "last_name": {"type": "keyword"}, "birth_date": {"type": "date"}, "gender": {"type": "keyword"}, "hire_date": {"type": "date"}, "languages": {"type": "integer"}, "height": {"type": "double"}, "salary": {"type": "integer"}, "still_hired": {"type": "boolean"}}}}

FROM employees_declared_noop
| KEEP emp_no, first_name, last_name, birth_date, gender, hire_date, languages, height, salary, still_hired
| SORT emp_no
| LIMIT 5;

emp_no:integer | first_name:keyword | last_name:keyword | birth_date:date          | gender:keyword | hire_date:date           | languages:integer | height:double | salary:integer | still_hired:boolean
10001          | "Georgi"           | "Facello"         | 1953-09-02T00:00:00.000Z | "M"            | 1986-06-26T00:00:00.000Z | 2                 | 2.03          | 57305          | true
10002          | "Bezalel"          | "Simmel"          | 1964-06-02T00:00:00.000Z | "F"            | 1985-11-21T00:00:00.000Z | 5                 | 2.08          | 56371          | true
10003          | "Parto"            | "Bamford"         | 1959-12-03T00:00:00.000Z | "M"            | 1986-08-28T00:00:00.000Z | 4                 | 1.83          | 61805          | false
10004          | "Chirstian"        | "Koblick"         | 1954-05-01T00:00:00.000Z | "M"            | 1986-12-01T00:00:00.000Z | 5                 | 1.78          | 36174          | true
10005          | "Kyoichi"          | "Maliniak"        | 1955-01-21T00:00:00.000Z | "M"            | 1989-09-12T00:00:00.000Z | 1                 | 2.05          | 63528          | true
;

// The no-op taken all the way: EVERY one of the fixture's 23 columns declared, so strict has nothing left to
// infer and the declaration is the entire schema. Pins two things the 10-column no-op above does not: that a
// DOTTED declared name (languages.long, height.float, salary_change.int) binds to the header column of that
// name rather than being read as a nested path, and that the types a no-op must restate are the WIDENED ones
// -- the header annotates languages.short:short and height.float:float, but inference widens short/byte to
// integer and float/half_float/scaled_float to double, so those are what the declaration says.
strictFullyDeclaredSchemaMatchingInferenceChangesNothing
required_capability: dataset_in_from_command
dataset: employees_declared_full: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"birth_date": {"type": "date"}, "emp_no": {"type": "integer"}, "first_name": {"type": "keyword"}, "gender": {"type": "keyword"}, "hire_date": {"type": "date"}, "languages": {"type": "integer"}, "languages.long": {"type": "long"}, "languages.short": {"type": "integer"}, "languages.byte": {"type": "integer"}, "last_name": {"type": "keyword"}, "salary": {"type": "integer"}, "height": {"type": "double"}, "height.float": {"type": "double"}, "height.scaled_float": {"type": "double"}, "height.half_float": {"type": "double"}, "still_hired": {"type": "boolean"}, "avg_worked_seconds": {"type": "long"}, "job_positions": {"type": "keyword"}, "is_rehired": {"type": "boolean"}, "salary_change": {"type": "double"}, "salary_change.int": {"type": "integer"}, "salary_change.long": {"type": "long"}, "salary_change.keyword": {"type": "keyword"}}}}

FROM employees_declared_full
| KEEP emp_no, first_name, languages.long, height.float, salary_change.int
| SORT emp_no
| LIMIT 3;

emp_no:integer | first_name:keyword | languages.long:long | height.float:double | salary_change.int:integer
10001          | "Georgi"           | 2                   | 2.03                | 1
10002          | "Bezalel"          | 5                   | 2.08                | -7
10003          | "Parto"            | 4                   | 1.83                | 14
;

// The same no-op declaration under dynamic:true, where it overlays inference instead of replacing it. An
// overlay that restates what inference already derived must also change nothing, so this reads identically to
// the strict no-op above and to the undeclared read -- the knob is a no-op when the declaration is.
dynamicDeclaredSchemaMatchingInferenceChangesNothing
required_capability: dataset_in_from_command
dataset: employees_declared_noop_overlay: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "true", "properties": {"emp_no": {"type": "integer"}, "first_name": {"type": "keyword"}, "last_name": {"type": "keyword"}, "birth_date": {"type": "date"}, "gender": {"type": "keyword"}, "hire_date": {"type": "date"}, "languages": {"type": "integer"}, "height": {"type": "double"}, "salary": {"type": "integer"}, "still_hired": {"type": "boolean"}}}}

FROM employees_declared_noop_overlay
| KEEP emp_no, first_name, last_name, birth_date, gender, hire_date, languages, height, salary, still_hired
| SORT emp_no
| LIMIT 5;

emp_no:integer | first_name:keyword | last_name:keyword | birth_date:date          | gender:keyword | hire_date:date           | languages:integer | height:double | salary:integer | still_hired:boolean
10001          | "Georgi"           | "Facello"         | 1953-09-02T00:00:00.000Z | "M"            | 1986-06-26T00:00:00.000Z | 2                 | 2.03          | 57305          | true
10002          | "Bezalel"          | "Simmel"          | 1964-06-02T00:00:00.000Z | "F"            | 1985-11-21T00:00:00.000Z | 5                 | 2.08          | 56371          | true
10003          | "Parto"            | "Bamford"         | 1959-12-03T00:00:00.000Z | "M"            | 1986-08-28T00:00:00.000Z | 4                 | 1.83          | 61805          | false
10004          | "Chirstian"        | "Koblick"         | 1954-05-01T00:00:00.000Z | "M"            | 1986-12-01T00:00:00.000Z | 5                 | 1.78          | 36174          | true
10005          | "Kyoichi"          | "Maliniak"        | 1955-01-21T00:00:00.000Z | "M"            | 1989-09-12T00:00:00.000Z | 1                 | 2.05          | 63528          | true
;

// Strict declaration that renames and retypes: physical emp_no/first_name are exposed as id/name, and
// every other column of the file is hidden. Discriminating by construction -- if the declaration were
// dropped anywhere in the chain the dataset would resolve by inference to the file's 23 header columns
// and `SORT id` would fail on an unknown column, and if only the retype were lost the pinned id:long
// would not match the inferred emp_no:integer.
strictDeclaredSchemaRenamesAndRetypes
required_capability: dataset_in_from_command
dataset: employees_declared_strict: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"id": {"type": "long", "path": "emp_no"}, "name": {"type": "keyword", "path": "first_name"}}}}

FROM employees_declared_strict
| SORT id
| LIMIT 3;

id:long | name:keyword
10001   | "Georgi"
10002   | "Bezalel"
10003   | "Parto"
;

// A declaration and format settings must BOTH survive the split, so this case is discriminating on each
// axis independently. header_row:false turns the typed header line into data row 0 and synthesizes
// f0..f22 (column_prefix "f"), so `path: "f1"` names field 1, the emp_no column -- a headerless file's
// column names ARE its positions, so the declaration self-binds without reading any header. Lose the
// settings and the file is read WITH its header, f1 names nothing, and the column reads null; lose the
// declaration and there is no `id` column at all.
strictDeclaredSchemaCoexistsWithFormatSettings
required_capability: dataset_in_from_command
required_capability: external_csv_header_row_option
required_capability: datasource_file_readers_no_text_type
dataset: employees_declared_headerless: "{{employees_no_mv}}" WITH {"header_row": false, "column_prefix": "f", "mappings": {"dynamic": "false", "properties": {"id": {"type": "keyword", "path": "f1"}}}}

FROM employees_declared_headerless
| KEEP id
| LIMIT 2
;

id:keyword
"emp_no:integer"
"10001"
;

// dynamic:true overlays the declaration on inference rather than replacing it: emp_no is retyped to LONG
// while every undeclared column is still inferred. The pinned emp_no:long is what discriminates -- the
// inferred type is integer.
dynamicDeclaredSchemaOverlaysInferredColumns
required_capability: dataset_in_from_command
dataset: employees_declared_overlay: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "true", "properties": {"emp_no": {"type": "long", "path": "emp_no"}}}}

FROM employees_declared_overlay
| KEEP emp_no, first_name, salary
| SORT emp_no
| LIMIT 3;

emp_no:long | first_name:keyword | salary:integer
10001       | "Georgi"           | 57305
10002       | "Bezalel"          | 56371
10003       | "Parto"            | 61805
;

// A declaration binds BY NAME even with no `path` on any column: binding is keyed on the schema's
// provenance (declared vs inferred), not on whether a path was written, so `dynamic` cannot leak into how
// columns bind (esql-planning#1307). This declaration is deliberately NOT in file order -- the file is
// birth_date, emp_no, first_name, ... -- so binding it by declaration POSITION would serve birth_date's
// values under `first_name`. It also pins that the declaration's property order survives the trip through
// the registry into the PUT body, since the output column order is the declared order.
strictDeclaredSchemaWithoutPathBindsByNameNotPosition
required_capability: dataset_in_from_command
dataset: employees_declared_byname: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"first_name": {"type": "keyword"}, "emp_no": {"type": "long"}}}}

FROM employees_declared_byname
| SORT emp_no
| LIMIT 3;

first_name:keyword | emp_no:long
"Georgi"           | 10001
"Bezalel"          | 10002
"Parto"            | 10003
;

// A declared column the file does not supply reads null and warns, rather than failing the read: the
// declaration is the contract, and a file that is missing a column is a data problem the caller sees in
// the values. `department` is not among the fixture's 23 columns. The warning names the PHYSICAL column it
// could not find (the `path`), not the logical name the query sees.
strictDeclaredSchemaAbsentColumnReadsNull
required_capability: dataset_in_from_command
dataset: employees_declared_absent: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"id": {"type": "long", "path": "emp_no"}, "dept": {"type": "keyword", "path": "department"}}}}

FROM employees_declared_absent
| SORT id
| LIMIT 3;
warningRegex:declared column \[department\] is not present in some source files and reads null there

id:long | dept:keyword
10001   | null
10002   | null
10003   | null
;

// Aggregates over a declared column, which the harness runs cold then warm automatically, so this asserts
// the declaration is in force on the coordinator's cached per-file schema as well as on the cold scan --
// the aggregate-metadata pushdown that serves COUNT/MIN/MAX from that cache is a second code path.
strictDeclaredSchemaAggregatesColdAndWarm
required_capability: dataset_in_from_command
dataset: employees_declared_strict: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"id": {"type": "long", "path": "emp_no"}, "name": {"type": "keyword", "path": "first_name"}}}}

FROM employees_declared_strict
| STATS rows = COUNT(*), lowest = MIN(id), highest = MAX(id);

rows:long | lowest:long | highest:long
100       | 10001       | 10100
;
